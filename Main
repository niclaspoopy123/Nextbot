local RAY_PARAMS = RaycastParams.new()
RAY_PARAMS.FilterType = Enum.RaycastFilterType.Exclude
RAY_PARAMS.IgnoreWater = false 

local SCORE = 0 
local IS_FROZEN = false 
local IS_SPECTATING = false 

-- [[ ML PATTERN MEMORY ]]
-- Stores player movement history for pattern recognition
local PlayerMemory = {
	positions = {}, -- Ring buffer of positions
	velocities = {}, -- Ring buffer of velocities
	directions = {}, -- Ring buffer of movement direction changes
	writeIndex = 1,
	totalSamples = 0,
	
	-- Learned behaviors
	avgTurnRate = 0, -- How often player changes direction
	preferredEscapeDir = Vector3.zero, -- Which direction player tends to run
	avgSpeed = 0,
	dodgePattern = 0, -- 0 = no pattern, 1 = left-right, 2 = circular, 3 = random
	lastDodgeTime = 0,
	consecutiveEscapes = 0, -- Times player escaped after being close
	
	-- Adaptive weights
	predictionAccuracy = 0.5, -- Running average of prediction accuracy
	aggressionLevel = 0.5, -- How aggressive the bot should be (0-1)
}

local function recordPlayerState(position, velocity)
	local mem = PlayerMemory
	local idx = mem.writeIndex
	
	mem.positions[idx] = position
	mem.velocities[idx] = velocity
	
	-- Calculate direction change
	local prevIdx = idx - 1
	if prevIdx < 1 then prevIdx = CONFIG.ML_HISTORY_SIZE end
	
	if mem.velocities[prevIdx] then
		local prevVel = mem.velocities[prevIdx]
		local currVel = velocity
		if prevVel.Magnitude > 1 and currVel.Magnitude > 1 then
			local dot = prevVel.Unit:Dot(currVel.Unit)
			mem.directions[idx] = dot -- 1 = same dir, -1 = reversed
		else
			mem.directions[idx] = 1
		end
	end
	
	-- Update ring buffer
	mem.writeIndex = (idx % CONFIG.ML_HISTORY_SIZE) + 1
	mem.totalSamples = math.min(mem.totalSamples + 1, CONFIG.ML_HISTORY_SIZE)
	
	-- Update running averages
	if mem.totalSamples > 5 then
		-- Average turn rate (how much direction changes)
		local turnSum = 0
		local count = 0
		for i = 1, mem.totalSamples do
			if mem.directions[i] then
				turnSum = turnSum + (1 - mem.directions[i])
				count = count + 1
			end
		end
		if count > 0 then
			mem.avgTurnRate = mem.avgTurnRate * 0.95 + (turnSum / count) * 0.05
		end
		
		-- Average speed
		local speedSum = 0
		local speedCount = 0
		for i = 1, mem.totalSamples do
			if mem.velocities[i] then
				speedSum = speedSum + mem.velocities[i].Magnitude
				speedCount = speedCount + 1
			end
		end
		if speedCount > 0 then
			mem.avgSpeed = mem.avgSpeed * 0.9 + (speedSum / speedCount) * 0.1
		end
		
		-- Detect dodge patterns
		if mem.avgTurnRate > 0.8 then
			mem.dodgePattern = 1 -- Erratic/dodging
		elseif mem.avgTurnRate > 0.4 then
			mem.dodgePattern = 2 -- Moderate turns (circular)
		else
			mem.dodgePattern = 3 -- Running straight
		end
	end
end

local function predictWithML(botPos, playerPos, playerVel)
	local mem = PlayerMemory
	
	if mem.totalSamples < 10 then
		-- Not enough data, use basic linear prediction
		return playerPos + playerVel * CONFIG.PREDICTION_FACTOR, "LEARNING"
	end
	
	local speed = playerVel.Magnitude
	if speed < 3 then
		return playerPos, "STATIONARY"
	end
	
	-- Base linear prediction
	local linearPred = playerPos + playerVel * CONFIG.PREDICTION_FACTOR
	
	-- ML-enhanced prediction based on learned patterns
	local mlPred = linearPred
	
	if mem.dodgePattern == 1 then
		-- Player dodges a lot - predict they'll change direction
		-- Use weighted average of recent direction changes to anticipate next move
		local anticipatedTurn = mem.avgTurnRate * CONFIG.FLANK_ANGLE
		local perpDir = Vector3.new(-playerVel.Unit.Z, 0, playerVel.Unit.X)
		
		-- Alternate prediction side based on recent pattern
		local recentBias = 0
		for i = math.max(1, mem.totalSamples - 5), mem.totalSamples do
			if mem.directions[i] then
				recentBias = recentBias + mem.directions[i]
			end
		end
		local side = recentBias > 0 and -1 or 1
		mlPred = linearPred + perpDir * (side * speed * 0.3 * mem.avgTurnRate)
		
	elseif mem.dodgePattern == 2 then
		-- Circular movement - predict curve continuation
		local recentPositions = {}
		for i = math.max(1, mem.totalSamples - 10), mem.totalSamples do
			if mem.positions[i] then
				table.insert(recentPositions, mem.positions[i])
			end
		end
		
		if #recentPositions >= 3 then
			-- Estimate curve direction from last 3 points
			local p1 = recentPositions[#recentPositions - 2]
			local p2 = recentPositions[#recentPositions - 1]
			local p3 = recentPositions[#recentPositions]
			local curve = (p3 - p2) - (p2 - p1)
			mlPred = linearPred + curve * 2
		end
		
	elseif mem.dodgePattern == 3 then
		-- Running straight - predict further ahead and try to cut off
		local cutoffFactor = 1.5
		mlPred = playerPos + playerVel * (CONFIG.PREDICTION_FACTOR * cutoffFactor)
	end
	
	-- Blend linear and ML predictions based on accuracy
	local blendWeight = CONFIG.ML_PATTERN_WEIGHT * math.clamp(mem.predictionAccuracy, 0.2, 0.9)
	local finalPred = linearPred:Lerp(mlPred, blendWeight)
	
	-- Aggression adjustment - if bot keeps failing, become more aggressive
	if mem.aggressionLevel > 0.7 then
		-- Aim slightly ahead of prediction
		local toPlayer = (playerPos - botPos).Unit
		finalPred = finalPred + toPlayer * (mem.aggressionLevel * 5)
	end
	
	return finalPred, "ML_" .. tostring(mem.dodgePattern)
end

local function updatePredictionAccuracy(predictedPos, actualPos)
	local mem = PlayerMemory
	local error = (predictedPos - actualPos).Magnitude
	local accuracy = math.clamp(1 - (error / 30), 0, 1)
	mem.predictionAccuracy = mem.predictionAccuracy * (1 - CONFIG.ML_ADAPTATION_RATE) + accuracy * CONFIG.ML_ADAPTATION_RATE
	
	-- Adjust aggression based on consecutive escapes
	if error > 15 then
		mem.consecutiveEscapes = mem.consecutiveEscapes + 1
		if mem.consecutiveEscapes > 5 then
			mem.aggressionLevel = math.min(1, mem.aggressionLevel + 0.05)
		end
	else
		mem.consecutiveEscapes = math.max(0, mem.consecutiveEscapes - 1)
		mem.aggressionLevel = math.max(0.3, mem.aggressionLevel - 0.02)
	end
end

-- 1. HELPER: RAGDOLL
local function triggerRagdoll(character)
	local humanoid = character:FindFirstChild("Humanoid")
	if not humanoid then return end
	if humanoid:GetState() == Enum.HumanoidStateType.Physics then return end

	humanoid.BreakJointsOnDeath = false
	humanoid:ChangeState(Enum.HumanoidStateType.Physics)

	for _, v in pairs(character:GetDescendants()) do
		if v:IsA("Motor6D") then
			local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
			a0.CFrame = v.C0; a1.CFrame = v.C1; a0.Parent = v.Part0; a1.Parent = v.Part1
			local b = Instance.new("BallSocketConstraint"); b.Attachment0 = a0; b.Attachment1 = a1; b.Parent = v.Part0
			v:Destroy() 
		elseif v:IsA("BasePart") then
			v.CanCollide = true 
		end
	end
end

