	SPEED_SLOW_MATS = { [Enum.Material.Sand] = 0.7, [Enum.Material.Grass] = 0.9 },
	
	-- Adaptive Difficulty
	DIFFICULTY_SCALE_KILLS = 0.02, -- Speed increase per kill
