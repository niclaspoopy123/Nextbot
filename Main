	PREDICTION_FACTOR = 0.8,
	WALL_READ_DIST = 25,
	CORNER_TRAP_MAX_DIST = 150,
	ML_HISTORY_SIZE = 60, -- Number of frames to track for pattern learning
	ML_PATTERN_WEIGHT = 0.6, -- How much to weight learned patterns vs linear prediction
	ML_ADAPTATION_RATE = 0.05, -- How fast the bot adapts to player behavior
	FLANK_ANGLE = math.rad(45), -- Angle offset for flanking maneuvers
	FLANK_DISTANCE_THRESHOLD = 40, -- Start flanking when farther than this
	
	-- Unstuck Mechanics
	UNSTUCK_VELOCITY_UP = 25,
